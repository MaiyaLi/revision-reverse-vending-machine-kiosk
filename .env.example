# ReVision Reverse Vending Machine Kiosk - Environment Configuration
# Copy this file to .env and fill in your values, or set these as
# environment variables directly in your deployment environment.

# Local YOLO detection (Ultralytics YOLO + OpenCV + NumPy)
# Default is true for quota-free offline operation
USE_YOLO="true"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string for transaction storage
# Format: postgresql://username:password@host:port/database
# PRODUCTION: Set via environment variable — do not commit real credentials.
DATABASE_URL="postgresql://postgres:password@localhost:5432/revision_rvm"

# ============================================
# SMTP CONFIGURATION (Email Receipts)
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="ReVision RVM <no-reply@yourdomain.com>"

# ============================================
# OPERATOR-CONTROLLED PAYOUT
# ============================================
# Email address that receives payout approval requests (Gmail SMTP must be configured above)
OPERATOR_EMAIL="operator@example.com"

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV="production"
PORT="3000"

# ============================================
# TLS / HTTPS CONFIGURATION
# ============================================
# Enable HTTPS/TLS encryption for sensitive data (PINs, wallet info)
ENABLE_HTTPS="true"

# Port for HTTPS server (separate from HTTP PORT)
HTTPS_PORT="3443"

# Paths to SSL certificate and private key files
# If not found, a self-signed certificate will be generated automatically (requires openssl)
SSL_KEY_PATH="certs/key.pem"
SSL_CERT_PATH="certs/cert.pem"

# CORS allowed origins (comma-separated). Only requests from these origins are accepted.
# Add HTTPS origins when HTTPS is enabled.
ALLOWED_ORIGINS="http://localhost:3000"

# ============================================
# CSRF PROTECTION
# ============================================
# Secret used to sign CSRF tokens. Change in production and use a secrets manager.
CSRF_SECRET="change-this-in-production"

# ============================================
# ADMIN PANEL ACCESS
# ============================================
# Required to access /api/admin/* endpoints. Set via environment variable in production.
ADMIN_API_KEY="your_secure_admin_api_key_here"
