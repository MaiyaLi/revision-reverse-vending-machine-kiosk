# Gemini AI Vision Classification
# Gemini is disabled by default. Set USE_GEMINI=true and add your key to enable cloud detection.
GEMINI_API_KEY=""

# Local TFLite detection (OpenCV + TFLite + NumPy)
# Default is true for quota-free offline operation
USE_TFLITE="true"

# Local YOLO detection fallback (requires Python + ultralytics)
USE_LOCAL_DETECTION="false"

# Enable Gemini cloud detection (overrides local defaults)
USE_GEMINI="false"

# Local TFLite detection (OpenCV + TFLite + NumPy)
# Set to true to use offline TFLite detection instead of Gemini/YOLO
USE_TFLITE="false"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string for transaction storage
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/revision_rvm"

# ============================================
# XENDIT E-WALLET INTEGRATION
# ============================================
# Get your API keys from https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY="xnd_development_YOUR_KEY_HERE"

# Create a random secure token for webhook verification
XENDIT_WEBHOOK_TOKEN="your_webhook_verification_token_here"

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV="development"
PORT="3000"

# ============================================
# ADMIN PANEL ACCESS
# ============================================
# Required to access /api/admin/* endpoints
ADMIN_API_KEY="your_secure_admin_api_key_here"
